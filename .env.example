# Copy to .env (`make env` does this and fills every "change-me" with a random secret).
# URLs below are for host-side tooling (tests, scripts); docker compose overrides the hosts.

# --- Databases & cache -------------------------------------------------------------------
APP_DB_PASSWORD=change-me
TARGET_DB_OWNER_PASSWORD=change-me
ANALYST_RO_PASSWORD=change-me
APP_DATABASE_URL=postgresql://app:${APP_DB_PASSWORD}@localhost:5433/app
# The agent's only target-DB credentials: read-only role, RLS applies.
TARGET_DATABASE_URL=postgresql://analyst_ro:${ANALYST_RO_PASSWORD}@localhost:5434/olist
# Schema owner, used only by scripts/load_olist.py.
TARGET_ADMIN_DATABASE_URL=postgresql://olist_owner:${TARGET_DB_OWNER_PASSWORD}@localhost:5434/olist
REDIS_URL=redis://localhost:6380/0

# --- Auth & security ---------------------------------------------------------------------
SESSION_SECRET=change-me
# Signs the per-transaction RLS scope; loaded into the target DB by `make seed`.
RLS_SIGNING_SECRET=change-me
DEMO_LOGIN_ENABLED=true
# Optional password-login admin created by `make seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- LLM ---------------------------------------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | openai_compat
ANTHROPIC_API_KEY=
LLM_MODEL_SQL=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
FAKE_LLM=false                  # deterministic fake for tests/e2e

# --- Embeddings --------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed    # fastembed | openai_compat | fake (tests: hashing, no model)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384               # used by the migration; change before the first migrate

# --- Agent limits & demo safety ----------------------------------------------------------
N_CANDIDATES=3
MAX_REPAIRS=2
STATEMENT_TIMEOUT_MS=10000
ROW_LIMIT=1000
EXPLAIN_COST_LIMIT=
RATE_LIMIT_PER_MIN=10
DAILY_LLM_BUDGET_USD=5

# --- Observability -----------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MCP server --------------------------------------------------------------------------
MCP_API_TOKEN=
MCP_PERSONA=analyst

# --- Edge --------------------------------------------------------------------------------
SITE_ADDRESS=:8080              # set to your domain in production for automatic HTTPS
HTTP_PORT=8080
